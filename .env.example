SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=*
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://127.0.0.1:8000

# Database
DB_NAME=mydb
DB_USER=myuser
DB_PASSWORD=strongpassword
DB_HOST=localhost
DB_PORT=5432

# Email (SMTP)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email_user
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=support@example.com
SERVER_EMAIL=support@example.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_CREDIT_PRICE_40=price_xxx
STRIPE_CREDIT_PRICE_50=price_xxx
STRIPE_CREDIT_PRICE_60=price_xxx
STRIPE_SUBSCRIPTION_PRICE_29=price_xxx

# AI Providers
OPENAI_API_KEY=your_openai_api_key
STABILITY_API_KEY=your_stability_api_key
GEMINI_API_KEY=your_gemini_api_key

# Gelato API
GELATO_API_KEY=your_gelato_api_key
GELATO_BASE_URL=https://order.gelatoapis.com/v4
GELATO_SUPPORTED_PRODUCT_UIDS=

# Meta Pixel
META_PIXEL_ID=your_meta_pixel_id
META_ACCESS_TOKEN=your_meta_access_token